PORT=3000
BASE_URL=http://localhost:3000

# Use long random values in production. Never commit .env.
POSTBACK_SECRET=replace_with_a_long_random_webhook_secret
REDEEM_API_KEY=replace_with_a_different_long_random_api_key

# Set true ONLY for local testing. This exposes a simulated install endpoint.
ENABLE_DEMO_ENDPOINT=true
